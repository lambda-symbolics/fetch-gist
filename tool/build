#!/usr/bin/env -S sbcl --script

;;; tool/build --- build and test fetch-gist with plain SBCL.

(require :asdf)

(defparameter *script-root*
  (merge-pathnames "../"
                   (make-pathname :defaults *load-truename*
                                  :name nil :type nil))
  "The repository root directory.")

(defun quicklisp-setup ()
  "Return the Quicklisp setup file in the home directory, or NIL."
  (let ((setup (merge-pathnames "quicklisp/setup.lisp"
                                (user-homedir-pathname))))
    (and (probe-file setup) setup)))

(let ((setup (quicklisp-setup)))
  (unless setup
    (format *error-output*
            "tool/build: Quicklisp not found; expected $HOME/quicklisp/setup.lisp~%")
    (uiop:quit 1))
  (load setup))

(push *script-root* asdf:*central-registry*)

(ql:quickload "fetch-gist")

(defun build ()
  (let ((target (merge-pathnames "bin/fetch-gist" *script-root*)))
    (ensure-directories-exist target)
    (format t "Building ~A~%" (namestring target))
    (sb-ext:save-lisp-and-die (namestring target)
                              :executable t
                              :toplevel (lambda ()
                                          (apply #'fetch-gist.cli:main
                                                 (uiop:command-line-arguments))))))

(defun test ()
  (ql:quickload "fetch-gist/tests")
  (asdf:test-system "fetch-gist"))

(defun usage (&optional (stream *standard-output*))
  (format stream "Usage: tool/build <build|test>~%")
  (format stream "~@{~A~%~}"
          "Commands:"
          "  build  Build the fetch-gist executable into bin/fetch-gist."
          "  test   Run the fetch-gist test suite."))

(defun main (args)
  (let ((subcommand (first args)))
    (cond
      ((null subcommand)
       (usage *error-output*)
       (uiop:quit 1))
      ((member subcommand '("help" "--help") :test #'string=)
       (usage)
       (uiop:quit 0))
      ((string= subcommand "build")
       (build)
       (uiop:quit 0))
      ((string= subcommand "test")
       (test)
       (uiop:quit 0))
      (t
       (format *error-output* "tool/build: unknown command: ~A~%" subcommand)
       (usage *error-output*)
       (uiop:quit 1)))))

(main (uiop:command-line-arguments))
